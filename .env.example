# ==============================================================================
# TEMURASA — PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Copy this file to .env for local development.
# 2. Add these variables to your Vercel Project Settings > Environment Variables for Production.
# 3. DO NOT commit actual secrets or production keys to Git!

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Prisma ORM)
# ------------------------------------------------------------------------------
# LOCAL DEVELOPMENT (Default SQLite):
DATABASE_URL="file:./dev.db"

# VERCEL / PRODUCTION (PostgreSQL via Supabase, Neon, AWS RDS, or Prisma Postgres):
# Use Connection Pooling for serverless lambdas (e.g. Supabase port 6543 with pgbouncer):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Optional: Supabase Public & Secret Keys (if using Supabase Auth or Storage)
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..." # NEVER expose to client/frontend!

# ------------------------------------------------------------------------------
# 2. APPLICATION BASE URL
# ------------------------------------------------------------------------------
# Local:
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production (Set to your custom domain or Vercel production URL):
# NEXT_PUBLIC_APP_URL="https://temurasa.love"

# ------------------------------------------------------------------------------
# 3. MIDTRANS PAYMENT GATEWAY (IDR 10,000 per couple room)
# ------------------------------------------------------------------------------
# Set MIDTRANS_IS_PRODUCTION to "true" for Live production, or "false" for Sandbox
MIDTRANS_IS_PRODUCTION="false"

# Midtrans Sandbox Credentials:
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxx"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxx"

# Midtrans Production Credentials (When ready to accept real money):
# MIDTRANS_SERVER_KEY="Mid-server-xxxxxxxxxxxxxx"
# NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="Mid-client-xxxxxxxxxxxxxx"

# Webhook Notification URL to set in Midtrans Dashboard:
# https://your-domain.vercel.app/api/payment/webhook

# ------------------------------------------------------------------------------
# 4. PAYMENT SIMULATOR TOGGLE (Development / Testing)
# ------------------------------------------------------------------------------
# Set to "true" to allow testing without real gateway transactions
# Set to "false" in live production
ENABLE_PAYMENT_SIMULATOR="true"

# ------------------------------------------------------------------------------
# 5. XENDIT PAYMENT GATEWAY (Alternative / Optional)
# ------------------------------------------------------------------------------
XENDIT_API_KEY=""
XENDIT_WEBHOOK_TOKEN=""

# ------------------------------------------------------------------------------
# 6. ADMIN DASHBOARD SECURITY
# ------------------------------------------------------------------------------
# Change this secret to a long, cryptographically random string in production!
ADMIN_SECRET="temurasa_prod_super_secure_admin_key_2026"
